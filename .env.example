BOT_TOKEN=
ALLOWED_USER_IDS=
HOSTS_CONFIG=hosts.toml
POLL_INTERVAL_SECONDS=30
SSH_CONNECT_TIMEOUT_SECONDS=10
COMMAND_TIMEOUT_SECONDS=35
OPERATION_TIMEOUT_SECONDS=90
MAX_CONCURRENT_HOSTS=4
ALERTS_ENABLED=true
ALERT_COOLDOWN_SECONDS=300
OFFLINE_SAMPLES=3
RESOURCE_SAMPLES=3
CPU_WARNING=85
CPU_CRITICAL=95
RAM_WARNING=80
RAM_CRITICAL=90
DISK_WARNING=80
DISK_CRITICAL=90
DATABASE_PATH=data/smolbot.db
EVENT_RETENTION_DAYS=30
LOG_LEVEL=INFO
PROTECTED_APP_NAMES=smolbot
# LOG_REDACT_VALUES='["extra secret value"]'
